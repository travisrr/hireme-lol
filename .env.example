# Public site. Production is workwithme.lol — not hireme.lol (parked / not ours).
PUBLIC_SITE_ORIGIN=https://workwithme.lol
PUBLIC_SITE_NAME=workwithme.lol

# Vite local (local API + magic-link preview URLs)
VITE_PUBLIC_SITE_ORIGIN=http://localhost:5173

# Cloudflare (fill after wrangler login — do not commit real IDs into git as secrets)
# CLOUDFLARE_ACCOUNT_ID=
# D1 database_id lives in wrangler.jsonc after `wrangler d1 create workwithme`

# Auth — magic link works without these. OAuth is optional.
ADMIN_EMAILS=tcrxx0@gmail.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test keys only in local .env — never commit)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Success/cancel must use workwithme.lol in production
STRIPE_SUCCESS_URL=https://workwithme.lol/?bid=success
STRIPE_CANCEL_URL=https://workwithme.lol/?bid=cancel

# Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email adapter (Resend or Mailgun). Do not create a paid account from this repo.
EMAIL_PROVIDER=resend
EMAIL_FROM=board@workwithme.lol
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Cloudflare Web Analytics (JS beacon only, no Google Analytics).
# Dashboard → Analytics & logs → Web Analytics → Add a site for workwithme.lol
# then: npx wrangler secret put CF_BEACON_TOKEN
# Leave empty locally. The Worker omits the snippet when this is unset.
CF_BEACON_TOKEN=

# CORS extras (comma-separated). Production always includes https://workwithme.lol
CORS_ORIGINS=http://localhost:5173,https://workwithme.lol
